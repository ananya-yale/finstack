# Secrets - never commit these. The real key lives in a .env one folder above
# the repo; .env.example is the only env file that belongs in git.
.env
.env.*
!.env.example
*.key

# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Fetched page cache and run artefacts. funders.json, tier_b.csv and the seed
# list ARE committed - they are the dataset the app needs to run.
data/pages/
data/server.log
data/build_log.txt
data/test_run.html

# Safety test output is regenerated by running the script
data/safety_report.txt

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Verification artefacts produced while building the report and slides
data/_target.txt
data/report_check.pdf
data/report_cover.png
data/report_impact.png
data/report_safety.png
data/slides/
.claude/
